# homestead-apply.service — privileged platform update apply (S265; ADR-027).
#
# Installed (not enabled) by scripts/install-systemd.sh. The daemon starts it
# (`systemctl --no-block start`) after staging a verified release and writing
# the apply marker; nothing else starts it and nothing enables it. It runs the
# installed binary in apply mode: it re-verifies the staged files, keeps the
# previous binary, replaces the daemon or CLI binary atomically, restarts
# homestead-server, waits (bounded) for it to be healthy, and finalizes the
# operation record from outside the daemon.
#
# This is the only unit allowed to replace platform executables. Binary-mode
# applies write only /usr/local/bin. The Debian package mode also writes the
# fixed Homestead package payload and dpkg/systemd bookkeeping paths. Its
# approved APT simulation refuses dependency changes or removals; apply invokes
# dpkg on only the staged package, so it cannot resolve or download packages.
# Neither mode writes appliance configuration, stacks, Docker data, or mounts.

[Unit]
Description=Homestead platform update apply

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/homestead-server apply-platform --data-dir /var/lib/homestead
TimeoutStartSec=600
ReadWritePaths=/var/lib/homestead /usr/local/bin /usr/local/share/homestead /usr/lib/systemd/system /usr/share/doc/homestead /var/lib/dpkg /var/lib/systemd/deb-systemd-helper-enabled /var/log/dpkg.log /etc/systemd/system/multi-user.target.wants
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
