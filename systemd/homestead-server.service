# homestead-server.service — Homestead control daemon (S011; see ADR-001).
#
# Installed to /etc/systemd/system/homestead-server.service by
# scripts/install-systemd.sh (sudo make install). systemd owns process
# supervision; the daemon drains gracefully on SIGTERM (see S010).
#
# Hardening is intentionally strict. ReadWritePaths grants exactly the state
# directories the layout owns (S012) plus the stacks directory installs
# write (S156), /usr/local/bin so a verified platform update can replace
# the daemon and CLI binaries in place (S265; the rest of /usr stays
# read-only), the packaged read-only catalog (S160, installed by
# install-systemd.sh alongside the binary), and the conventional mount
# roots owner storage lives under: provisioning and backups write
# assigned mounts by design, so /mnt and /media stay writable while
# /etc and /boot (and /usr outside /usr/local/bin) stay read-only. Mounts outside both need a unit
# drop-in extending ReadWritePaths plus a daemon reload.

[Unit]
Description=Homestead control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/homestead-server --listen 127.0.0.1:8080 --catalog-dir /usr/local/share/homestead/catalog
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
RuntimeDirectory=homestead
ReadWritePaths=/etc/homestead /var/lib/homestead /var/log/homestead /opt/homestead/stacks /usr/local/bin /mnt /media
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
